{
  "_comment": "Software catalog + profiles. 'filter' is matched inside the stick's Software\\ folder; {LANGTAG} becomes en-US or pt-BR. If no installer is found the winget id is used (internet needed).",
  "items": [
    { "id": "kasperskyprem", "name": "Kaspersky Premium",       "filter": "Kaspersky_Premium_*_{LANGTAG}.exe", "args": "/s /pEULA=1 /pPRIVACYPOLICY=1 /pKSN=1", "minutes": 30 },
    { "id": "kasperskypm",   "name": "Kaspersky Password Manager", "filter": "Kaspersky_Password-Manager_*_{LANGTAG}.exe", "args": "/s", "minutes": 15 },
    { "id": "kasperskyvpn",  "name": "Kaspersky VPN Secure Connection", "filter": "Kaspersky_VPN_*_{LANGTAG}.exe", "args": "/s", "minutes": 15 },
    { "id": "claude",   "name": "Claude",                    "filter": "Anthropic_Claude-Setup-WebStub_*.exe", "args": "", "minutes": 10 },
    { "id": "logi",     "name": "Logi Options+",             "filter": "Logitech_Options-Plus-Installer_*.exe", "args": "/quiet", "minutes": 10 },
    { "id": "reader",   "name": "Adobe Acrobat Reader",      "filter": "Adobe_Acrobat-Reader-Downloader_*.exe", "args": "/sAll /rs /rps /msi EULA_ACCEPT=YES", "minutes": 8, "killOnTimeout": true,
      "winget": "Adobe.Acrobat.Reader.64-bit", "wingetLocale": "pt-BR", "preferWingetFor": [ "PT" ] },
    { "id": "firefoxdev", "name": "Firefox Developer Edition", "filter": "Mozilla_Firefox-DeveloperEdition_x64_latest-*_{LANGTAG}.exe", "args": "/S", "minutes": 10, "winget": "Mozilla.Firefox.DeveloperEdition" },
    { "id": "terminal", "name": "Windows Terminal",          "filter": "Microsoft_Windows-Terminal_x64_*.msixbundle", "kind": "appx", "winget": "Microsoft.WindowsTerminal" },
    { "id": "ps7",      "name": "PowerShell 7",              "kind": "zip", "filter": "Microsoft_PowerShell_x64_*_Multi.zip", "extractTo": "%ProgramFiles%\\PowerShell\\7", "addToPath": true, "winget": "Microsoft.PowerShell" },
    { "id": "jdk",      "name": "Oracle JDK",                "filter": "Oracle_JDK_x64_*_Multi.exe", "args": "/s", "minutes": 15 },
    { "id": "node",     "name": "Node.js",                   "kind": "msi", "filter": "OpenJS_Node.js_x64_*_Multi.msi" },
    { "id": "ghcli",    "name": "GitHub CLI",                "kind": "msi", "filter": "GitHub_CLI-gh_x64_*_Multi.msi" },
    { "id": "git",      "name": "Git for Windows",           "filter": "Git-for-Windows_Setup_x64_*_Multi.exe", "args": "/VERYSILENT /NORESTART", "minutes": 15, "winget": "Git.Git" },
    { "id": "go",       "name": "Go",                        "kind": "msi", "filter": "Go_Installer_x64_*_Multi.msi", "winget": "GoLang.Go" },
    { "id": "intellij", "name": "IntelliJ IDEA Ultimate",    "winget": "JetBrains.IntelliJIDEA.Ultimate" },
    { "id": "goland",   "name": "GoLand",                    "winget": "JetBrains.GoLand" },
    { "id": "datagrip", "name": "DataGrip",                  "winget": "JetBrains.DataGrip" },
    { "id": "toolbox",  "name": "JetBrains Toolbox (only when winget is missing)", "filter": "JetBrains_Toolbox-Installer_x64_*_Multi.exe", "args": "/S", "minutes": 10, "onlyWithoutWinget": true },
    { "id": "docker",   "name": "Docker Desktop",            "filter": "Docker_Desktop-Installer_x64_*_Multi.exe", "args": "install --quiet --accept-license", "minutes": 30 },
    { "id": "postman",  "name": "Postman",                   "filter": "Postman_Setup_x64_*_Multi.exe", "args": "--silent", "minutes": 10 },
    { "id": "ghdesktop","name": "GitHub Desktop",            "filter": "GitHub_Desktop-Setup_x64_*_Multi.exe", "args": "--silent", "minutes": 10 },
    { "id": "nvidiaapp","name": "NVIDIA App",                "filter": "NVIDIA_App-Installer_x64_*_Multi.exe", "args": "-s", "minutes": 15 },
    { "id": "discord",  "name": "Discord",                   "filter": "Discord_Setup_x64_*_Multi.exe", "args": "-s", "minutes": 10, "winget": "Discord.Discord" },
    { "id": "steam",    "name": "Steam",                     "filter": "Valve_Steam-Setup_x86_*_Multi.exe", "args": "/S", "minutes": 10 },
    { "id": "ubisoft",  "name": "Ubisoft Connect",           "filter": "Ubisoft_Connect-Installer_Any_*_Multi.exe", "args": "/S", "minutes": 15 },
    { "id": "ea",       "name": "EA app",                    "filter": "EA_App-Installer_Any_*_Multi.exe", "args": "/silent", "minutes": 15 },
    { "id": "epic",     "name": "Epic Games Launcher",       "filter": "Epic-Games_Launcher-Installer_Any_*_Multi.exe", "args": "", "minutes": 5, "noWait": true },
    { "id": "xencelabs","name": "Xencelabs driver + profiles", "filter": "Xencelabs-Profiles\\Xencelabs_Driver_*.exe", "args": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART", "minutes": 15,
      "copyAfter": { "from": "Xencelabs-Profiles\\*.pcfg", "to": "%USERPROFILE%\\Documents\\Xencelabs-Profiles" } }
  ],
  "profiles": {
    "Full":     { "office": true,  "software": [ "claude", "logi", "reader", "firefoxdev", "terminal", "ps7", "jdk", "node", "ghcli", "git", "go", "intellij", "goland", "datagrip", "toolbox", "postman", "ghdesktop", "docker", "nvidiaapp", "discord", "steam", "ubisoft", "ea", "epic", "xencelabs" ] },
    "DevBasic": { "office": true,  "software": [ "claude", "logi", "reader", "firefoxdev", "terminal", "ps7", "jdk", "node", "ghcli", "git", "go", "intellij", "goland", "toolbox" ] },
    "Office":   { "office": true,  "software": [ "claude", "logi", "reader", "firefoxdev", "terminal", "ps7" ] },
    "Base":     { "office": true,  "software": [] },
    "Server":   { "office": false, "software": [] }
  }
}
